# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Anthropic (for receipt scanning)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Resend (server-side email — group invites, etc.)
RESEND_API_KEY=your_resend_api_key
# Optional overrides:
# EMAIL_FROM="Splittr <no-reply@splittr.cash>"   # must be on a verified Resend domain
# NEXT_PUBLIC_SITE_URL=https://splittr.cash        # used to build links inside emails
